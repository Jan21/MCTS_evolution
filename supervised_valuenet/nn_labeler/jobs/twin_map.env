# Which exact corpus each twin replays — MUST be the corpus the config's
# planners were trained on (comparison.json provenance). Sourced by
# gate_v2_and_twins.slurm at RUNTIME, so it can be corrected until the job
# actually starts. Verify before the job leaves the queue.
TWIN_CORPUS_g24r4=scaling/data/g24r4/backward.jsonl
TWIN_CORPUS_g24r8=scaling/data/g24r8/backward.rust.jsonl
TWIN_CORPUS_g32r4=scaling/data/g32r4/backward.rust.jsonl
